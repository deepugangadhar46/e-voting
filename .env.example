# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to Git!

# ============================================
# Hardhat Configuration (for Sepolia deployment)
# ============================================
# Get from Infura, Alchemy, or any Ethereum node provider
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Your wallet private key (for deploying to testnet)
# ⚠️ WARNING: Never share or commit this key!
# This is only for testnet, not mainnet
PRIVATE_KEY=your_wallet_private_key_here

# ============================================
# Backend Configuration
# ============================================
# MongoDB connection string
# For local MongoDB: mongodb://localhost:27017/voting-system
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/voting-system
MONGODB_URI=mongodb://localhost:27017/voting-system

# Backend server port
PORT=5000

# ============================================
# Frontend Configuration
# ============================================
# Smart contract address (auto-populated after deployment)
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
