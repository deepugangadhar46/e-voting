# Environment Variables Template
# Copy relevant sections to respective .env files
# ⚠️ NEVER commit actual .env files containing real secrets to Git!

# ============================================
# Root .env (for Hardhat testnet deployment)
# ============================================
# Get from Infura, Alchemy, or any Ethereum node provider
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# Deployer private key (Testnet only; NEVER use mainnet keys)
PRIVATE_KEY=your_testnet_private_key_here

# ============================================
# Backend: backend/.env
# ============================================
# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/voting-system
PORT=5000

# Strong random secret for signing authentication JWT tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_minimum_32_characters_random_hex

# Administrator public wallet address (e.g. Hardhat Account #0: 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266)
ADMIN_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# ============================================
# Frontend: frontend/.env.local
# ============================================
# Deployed Voting smart contract address
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# JSON-RPC Provider URL for read-only blockchain queries (e.g., Results page)
# NOTE: 127.0.0.1 points to the local device. If testing from a phone or other device on LAN,
# set this to your computer's LAN IP (e.g., http://192.168.1.100:8545).
VITE_RPC_URL=http://127.0.0.1:8545
